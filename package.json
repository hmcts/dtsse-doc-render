{
  "name": "dtsse-doc-render",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Unlicensed, API-compatible stand-in for Docmosis Tornado, for local development and non-production environments.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "echo 'No UI, nothing to check' && exit 0",
    "test:smoke": "vitest run --config test/smoke/vitest.config.mts",
    "test:functional": "vitest run --config test/functional/vitest.config.mts",
    "test:fullfunctional": "echo 'No full functional suite yet' && exit 0",
    "test:crossbrowser": "echo 'No UI, no cross-browser tests' && exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/busboy": "^1.5.5",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "applicationinsights": "3.17.0",
    "busboy": "1",
    "fflate": "^0.8.3"
  },
  "resolutions": {
    "@types/node": "26.6.11",
    "@opentelemetry/instrumentation-http": "0.222.0"
  }
}
